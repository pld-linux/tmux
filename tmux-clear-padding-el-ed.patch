Clear tabs and wide characters cut by EL and ED instead of leaving half of
them in the grid.
https://github.com/tmux/tmux/issues/5819
https://github.com/tmux/tmux/commit/4a3176186eaa60412db26d5716edc8642a6f0fa0 (tests: ad1000c9)

diff --git a/screen-write.c b/screen-write.c
index 9bd868fe..a429e39a 100644
--- a/screen-write.c
+++ b/screen-write.c
@@ -1666,6 +1666,7 @@ screen_write_clearendofline(struct screen_write_ctx *ctx, u_int bg)
 		ctx->wp->flags |= PANE_REDRAW;
 #endif
 
+	screen_write_clear_padding(ctx, s->cx);
 	grid_view_clear(s->grid, s->cx, s->cy, sx - s->cx, 1, bg);
 
 	ci->x = s->cx;
@@ -1695,8 +1696,10 @@ screen_write_clearstartofline(struct screen_write_ctx *ctx, u_int bg)
 
 	if (s->cx > sx - 1)
 		grid_view_clear(s->grid, 0, s->cy, sx, 1, bg);
-	else
+	else {
+		screen_write_clear_padding(ctx, s->cx + 1);
 		grid_view_clear(s->grid, 0, s->cy, s->cx + 1, 1, bg);
+	}
 
 	ci->x = 0;
 	ci->used = s->cx + 1;
@@ -1935,8 +1938,10 @@ screen_write_clearendofscreen(struct screen_write_ctx *ctx, u_int bg)
 	    options_get_number(ctx->wp->options, "scroll-on-clear"))
 		grid_view_clear_history(gd, bg);
 	else {
-		if (s->cx <= sx - 1)
+		if (s->cx <= sx - 1) {
+			screen_write_clear_padding(ctx, s->cx);
 			grid_view_clear(gd, s->cx, s->cy, sx - s->cx, 1, bg);
+		}
 		grid_view_clear(gd, 0, s->cy + 1, sx, sy - (s->cy + 1), bg);
 	}
 
@@ -2012,8 +2017,10 @@ screen_write_clearstartofscreen(struct screen_write_ctx *ctx, u_int bg)
 		grid_view_clear(s->grid, 0, 0, sx, s->cy, bg);
 	if (s->cx > sx - 1)
 		grid_view_clear(s->grid, 0, s->cy, sx, 1, bg);
-	else
+	else {
+		screen_write_clear_padding(ctx, s->cx + 1);
 		grid_view_clear(s->grid, 0, s->cy, s->cx + 1, 1, bg);
+	}
 
 	screen_write_collect_clear(ctx, 0, s->cy);
 	screen_write_collect_flush(ctx, 0, __func__);
